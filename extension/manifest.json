{
  "manifest_version": 3,
  "name": "Vaultix – Password Manager",
  "version": "3.1.7",
  "description": "Vaultix autofill: log in anywhere with your saved vault credentials — personal, shared, and company vaults.",
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Vaultix"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/autofill.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "vaultix@karnsphere.com",
      "strict_min_version": "115.0"
    }
  }
}
