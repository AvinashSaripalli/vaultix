generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Department {
  id             String                 @id
  name           String                 @unique
  description    String?
  parentId       String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  parent         Department?            @relation("DepartmentTree", fields: [parentId], references: [id])
  subDepartments Department[]           @relation("DepartmentTree")
  members        DepartmentMember[]
  permissions    DepartmentPermission[]
}

model DepartmentMember {
  id           String         @id
  departmentId String
  userId       String
  memberRole   DepartmentRole @default(MEMBER)
  createdAt    DateTime       @default(now())
  department   Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
}

model DepartmentPermission {
  id           String                @id
  departmentId String
  vaultId      String?
  folderId     String?
  accessLevel  DepartmentAccessLevel
  createdAt    DateTime              @default(now())
  department   Department            @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  folder       Folder?               @relation(fields: [folderId], references: [id], onDelete: Cascade)
  vault        Vault?                @relation(fields: [vaultId], references: [id], onDelete: Cascade)

  @@index([vaultId])
  @@index([folderId])
}

model User {
  id                      String             @id
  fullName                String
  email                   String             @unique
  passwordHash            String
  masterPasswordHash      String?
  masterPasswordHint      String?
  role                    Role               @default(USER)
  isActive                Boolean            @default(true)
  emailVerified           Boolean            @default(false)
  emailVerificationToken  String?
  emailVerificationExpiry DateTime?
  twoFactorEnabled        Boolean            @default(false)
  twoFactorSecret         String?
  twoFactorBackupCodes    Json?
  vaultTimeoutMinutes     Int                @default(15)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  encryptionSalt          String?
  recoveryKey             String?
  recoveryKeyEscrow       String?
  tokenVersion            Int                @default(0)
  activityLogs            ActivityLog[]
  departmentMemberships   DepartmentMember[]
  folderPermissions       FolderPermission[]
  sentInvitations         Invitation[]       @relation("InvitationSender")
  loginActivities         LoginActivity[]
  notifications           Notification[]
  createdPasswords        PasswordEntry[]    @relation("PasswordCreatedBy")
  sharedPasswordsSent     PasswordShare[]    @relation("PasswordSharedBy")
  sharedPasswordsReceived PasswordShare[]    @relation("PasswordSharedWith")
  keyPair                 UserKeyPair?
  ownedVaults             Vault[]            @relation("VaultOwner")
  vaultPermissions        VaultPermission[]
  refreshTokens           RefreshToken[]    @relation("RefreshTokenUser")
  webAuthnCredentials     WebAuthnCredential[]
}

model Folder {
  id                    String                 @id
  name                  String
  vaultId               String
  parentId              String?
  wrappedKeys           Json?
  blockedUserIds        Json?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  departmentPermissions DepartmentPermission[]
  parent                Folder?                @relation("FolderTree", fields: [parentId], references: [id])
  children              Folder[]               @relation("FolderTree")
  vault                 Vault                  @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  permissions           FolderPermission[]
  passwords             PasswordEntry[]
}

model FolderPermission {
  id          String            @id
  folderId    String
  userId      String
  accessLevel FolderAccessLevel
  createdAt   DateTime          @default(now())
  folder      Folder            @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([folderId, userId])
}

model Vault {
  id                    String                 @id
  name                  String
  type                  VaultType
  slug                  String                 @unique
  ownerId               String
  minStrengthScore      Int?
  maxAgeDays            Int?
  blockCommon           Boolean                @default(false)
  allowedTypes          Json?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  departmentPermissions DepartmentPermission[]
  folders               Folder[]
  passwords             PasswordEntry[]
  owner                 User                   @relation("VaultOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  permissions           VaultPermission[]
}

model VaultPermission {
  id          String           @id
  vaultId     String
  userId      String
  accessLevel VaultAccessLevel
  createdAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vault       Vault            @relation(fields: [vaultId], references: [id], onDelete: Cascade)

  @@unique([vaultId, userId])
}

model PasswordEntry {
  id                String          @id
  name              String
  login             String          @default("")
  type              ItemType        @default(LOGIN)
  encryptedPassword String          @default("")
  encryptedFields   String?
  encryptedNote     String?
  wrappedKeys       Json?
  url               String?
  colorTag          String?
  vaultId           String
  folderId          String?
  parentId          String?
  deletedAt         DateTime?
  createdById       String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  lastViewedAt      DateTime?
  lastUpdatedAt     DateTime?
  strengthScore     Int?
  isWeak            Boolean         @default(false)
  isOld             Boolean         @default(false)
  isAtRisk          Boolean         @default(false)
  isSensitive       Boolean         @default(false)
  createdBy         User            @relation("PasswordCreatedBy", fields: [createdById], references: [id])
  folder            Folder?         @relation(fields: [folderId], references: [id])
  parent            PasswordEntry?  @relation("EntryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children          PasswordEntry[] @relation("EntryTree")
  vault             Vault           @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  shares            PasswordShare[]
  tags              PasswordTag[]

  @@index([vaultId])
  @@index([folderId])
  @@index([createdById])
  @@index([parentId])
  @@index([deletedAt])
}

model Tag {
  id        String        @id
  name      String        @unique
  passwords PasswordTag[]
}

model PasswordTag {
  passwordId String
  tagId      String
  password   PasswordEntry @relation(fields: [passwordId], references: [id], onDelete: Cascade)
  tag        Tag           @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([passwordId, tagId])
}

model ActivityLog {
  id         String         @id
  userId     String
  action     ActivityAction
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime       @default(now())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action, createdAt])
}

model Invitation {
  id        String   @id
  email     String
  token     String   @unique
  role      Role     @default(USER)
  invitedBy String
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  inviter   User     @relation("InvitationSender", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@index([email])
}

model UserKeyPair {
  id                  String   @id
  userId              String   @unique
  encryptedPrivateKey Json
  publicKey           Json
  salt                String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordShare {
  id                  String        @id
  passwordId          String
  sharedWithId        String
  sharedById          String
  encryptedItemKey    String?
  reEncryptedPassword String?
  reEncryptedNote     String?
  reEncryptedFields   String?
  createdAt           DateTime      @default(now())
  password            PasswordEntry @relation(fields: [passwordId], references: [id], onDelete: Cascade)
  sharedBy            User          @relation("PasswordSharedBy", fields: [sharedById], references: [id], onDelete: Cascade)
  sharedWith          User          @relation("PasswordSharedWith", fields: [sharedWithId], references: [id], onDelete: Cascade)

  @@unique([passwordId, sharedWithId])
  @@index([sharedWithId])
  @@index([sharedById])
}

model LoginActivity {
  id        String      @id
  userId    String
  ipAddress String?
  userAgent String?
  status    LoginStatus
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id           String    @id
  userId       String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())
  user         User      @relation("RefreshTokenUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([revokedAt])
}

model WebAuthnCredential {
  id                String   @id
  userId            String
  credentialId      String   @unique
  publicKey         Json
  counter           BigInt   @default(0)
  transports        String?
  attestationFormat String?
  friendlyName      String?
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([credentialId])
}

model Notification {
  id        String           @id
  userId    String
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Role {
  ADMIN
  USER
}

enum FolderAccessLevel {
  READ_ONLY
  READ_WRITE
  FULL_ACCESS
  ADMINISTRATOR
  FORBIDDEN
}

enum VaultType {
  PERSONAL
  COMPANY
  CLIENT
}

enum VaultAccessLevel {
  READ_ONLY
  READ_WRITE
  FULL_ACCESS
  ADMINISTRATOR
}

enum DepartmentRole {
  MANAGER
  MEMBER
}

enum DepartmentAccessLevel {
  NOT_SET
  FORBIDDEN
  READ_ONLY
  READ_WRITE
  FULL_ACCESS
  ADMINISTRATOR
}

enum ItemType {
  LOGIN
  CARD
  BANK_ACCOUNT
  IDENTITY
  SECURE_NOTE
  SSH_KEY
  API_TOKEN
  DATABASE
  WIFI
  LICENSE
  RECOVERY_CODE
}

enum ActivityAction {
  REGISTER
  LOGIN
  CREATE_VAULT
  UPDATE_VAULT
  DELETE_VAULT
  CREATE_FOLDER
  UPDATE_FOLDER
  DELETE_FOLDER
  COPY_PASSWORD
  CREATE_PASSWORD
  UPDATE_PASSWORD
  DELETE_PASSWORD
  VIEW_PASSWORD
  SHARE_VAULT
  IMPORT_PASSWORDS
  SHARE_PASSWORD
  SHARE_FOLDER
  CREATE_DEPARTMENT
  UPDATE_DEPARTMENT
  DELETE_DEPARTMENT
  ADD_DEPARTMENT_MEMBER
  REMOVE_DEPARTMENT_MEMBER
  UPDATE_DEPARTMENT_MEMBER
  GRANT_DEPARTMENT_ACCESS
  REVOKE_DEPARTMENT_ACCESS
  ENABLE_2FA
  DISABLE_2FA
  VERIFY_EMAIL
}

enum LoginStatus {
  SUCCESS
  FAILED
  BLOCKED
}

enum NotificationType {
  LOGIN
  SECURITY
  PASSWORD
  SHARE_PASSWORD
  SHARE_FOLDER
  SHARE_VAULT
  WEAK_PASSWORD
  DEPARTMENT
}
